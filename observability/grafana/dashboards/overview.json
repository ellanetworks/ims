    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "description": "Share of REGISTER requests (initial registrations and re-registrations) that the IMS accepted. The 401 challenge of IMS-AKA and de-registrations are not counted. Over the selected time range. TS 32.409 registration success rate.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No attempts",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "unit": "percent",
          "noValue": "No attempts"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "editorMode": "code",
          "expr": "(\n  100 * (\n    sum(increase(ellaims_registration_attempts_total{job=~\"$job\",instance=~\"$instance\",result=\"accept\"}[$__range]))\n    /\n    sum(increase(ellaims_registration_attempts_total{job=~\"$job\",instance=~\"$instance\"}[$__range]))\n  )\n  and\n  sum(increase(ellaims_registration_attempts_total{job=~\"$job\",instance=~\"$instance\"}[$__range])) > 0\n)\nor vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Registration Success",
      "type": "stat",
      "id": 3
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "description": "Session establishment success rate: share of ended call attempts the network set up, every outcome except failed and unavailable (480). Busy, declined, cancelled and not answered are user outcomes, as in TS 32.409. Over the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No attempts",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "unit": "percent",
          "noValue": "No attempts"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "editorMode": "code",
          "expr": "(\n  100 * (\n    sum(increase(ellaims_calls_total{job=~\"$job\",instance=~\"$instance\",outcome!~\"failed|unavailable\"}[$__range]))\n    /\n    sum(increase(ellaims_calls_total{job=~\"$job\",instance=~\"$instance\"}[$__range]))\n  )\n  and\n  sum(increase(ellaims_calls_total{job=~\"$job\",instance=~\"$instance\"}[$__range])) > 0\n)\nor vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Session Setup Success",
      "type": "stat",
      "id": 4
    },
