+                if (ogs_media_component_is_af_signalling(media_component)) {
+                    /* TS 29.514 4.2.6.7: session binding only */
+                    memset(media_component, 0, sizeof(*media_component));
+                    continue;
+                }
+
                 ims_data.num_of_media_component++;
             }
         }
@@ -1444,6 +1451,13 @@
                         }
                     }
                 }
