+/*
+ * MCPTT: voice on QCI/5QI 65 (GBR), the floor control of MCPTT-4 on 65 or 69
+ * (TS 23.379 clause 5.7.3); 69 is Non-GBR, "Mission Critical delay sensitive
+ * signalling (e.g. MC-PTT signalling)" (TS 23.501 Table 5.7.4-1).
+ */
+#define QOS_INDEX_MCPTT_VOICE       65
+#define QOS_INDEX_MCPTT_SIGNALLING  69
+
+/*
+ * Whether an AF application identifier is the MCPTT ICSI, which the P-CSCF
+ * provides (TS 29.214 Annex A.13.1 NOTE 3, TS 29.514 Annex B.10.1 NOTE 3) as
+ * received in SIP: quoted, percent-encoded or not (TS 29.214 Annex A.1 NOTE 3).
+ */
+static bool af_app_id_is_mcptt(const char *id, size_t len)
+{
+    static const char icsi[] = "urn:urn-7:3gpp-service.ims.icsi.mcptt";
+    size_t i = 0, j = 0;
+
+    if (!id)
+        return false;
+
+    if (len >= 2 && id[0] == '"' && id[len-1] == '"') {
+        id++;
+        len -= 2;
+    }
+
+    while (i < len && icsi[j]) {
+        char c = id[i];
+
+        if (c == '%' && i + 2 < len && id[i+1] == '3' &&
+                (id[i+2] == 'A' || id[i+2] == 'a')) {
+            c = ':';
+            i += 3;
+        } else {
+            i++;
+        }
+
+        if (tolower((unsigned char)c) != icsi[j])
+            return false;
+        j++;
+    }
+
+    return i == len && !icsi[j];
+}
