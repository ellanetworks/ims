    entity="sip:alice@mcptt.example.com">
  <tuple id="urn-uuid-00000000-0000-1000-8000-0123456789ab">
    <status>
      <mcpttPI10:affiliation group="sip:group1@mcptt.example.com" status="affiliated" expires="2026-10-21T08:00:00Z"/>
      <mcpttPI10:affiliation group="sip:group2@mcptt.example.com" status="affiliating"/>
