  </tuple>
  <tuple id="client-2">
    <status>
      <mcpttPI10:affiliation group="sip:group1@mcptt.example.com"/>
    </status>
  </tuple>
  <mcpttPI10:p-id>publish-1</mcpttPI10:p-id>
