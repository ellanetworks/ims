<?xml version="1.0" encoding="UTF-8"?>
<!-- TS 24.379 §9.3.2.2: per-group dynamic data restrictions of presence event package notification information, of
     the group status and the group call ongoing information. -->
<filter-set xmlns="urn:ietf:params:xml:ns:simple-filter">
  <ns-bindings>
    <ns-binding prefix="pidf" urn="urn:ietf:params:xml:ns:pidf"/>
    <ns-binding prefix="mcpttPI10" urn="urn:3gpp:ns:mcpttPresInfo:1.0"/>
  </ns-bindings>
  <filter id="group-dynamic">
    <what>
      <include>//pidf:presence/pidf:groupStatus/@pidf:ModifiedBy</include>
      <include>//pidf:presence/pidf:additionalData/@pidf:groupCallOngoing</include>
    </what>
  </filter>
</filter-set>
